namespace_packages=[]

try:
    from setuptools import setup, find_namespace_packages
    namespace_packages=find_namespace_packages(include=['emane_node_view.*'])
except:
    from setuptools import setup

setup(name='emane-node-view',
      version='@VERSION@',
      description='EMANE Node View',
      long_description='EMANE Node View',
      author='Adjacent Link LLC',
      author_email='labs at adjacent link dot com',
      url="https://adjacentlink.com",
      license = 'BSD',
      include_package_data=True,
      packages=['emane_node_view'] + namespace_packages,
      scripts=['scripts/emane-node-view-publisher'])
